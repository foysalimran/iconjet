{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "iconjet/icon",
	"version": "1.0.0",
	"title": "Iconjet Icon",
	"category": "media",
	"description": "An SVG icon from the Iconjet library or your own uploaded icons.",
	"keywords": [
		"icon",
		"svg",
		"symbol",
		"iconjet"
	],
	"textdomain": "iconjet",
	"attributes": {
		"icon": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"svg": {
			"type": "object",
			"role": "content"
		},
		"size": {
			"type": "number"
		},
		"label": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"rotation": {
			"type": "number",
			"default": 0
		},
		"flipHorizontal": {
			"type": "boolean",
			"default": false
		},
		"flipVertical": {
			"type": "boolean",
			"default": false
		},
		"url": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"linkTarget": {
			"type": "string",
			"default": ""
		},
		"rel": {
			"type": "string",
			"default": ""
		},
		"justification": {
			"type": "string",
			"enum": [
				"left",
				"center",
				"right"
			]
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"color": {
			"text": true,
			"background": true,
			"link": false,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"text": true,
				"background": true
			}
		},
		"spacing": {
			"padding": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"padding": true
			}
		},
		"__experimentalBorder": {
			"radius": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"radius": true
			}
		}
	},
	"example": {
		"attributes": {
			"icon": "lucide:heart",
			"size": 64,
			"svg": {
				"v": "0 0 24 24",
				"b": "<path d=\"M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5\"/>",
				"a": {
					"fill": "none",
					"stroke": "currentColor",
					"stroke-width": "2",
					"stroke-linecap": "round",
					"stroke-linejoin": "round"
				}
			}
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": [
		"file:./index.css",
		"iconjet"
	]
}
