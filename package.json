{
	"name": "iconjet",
	"version": "1.0.0",
	"private": true,
	"description": "Lightweight SVG icons and social icons for Gutenberg, Elementor, and any page builder.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build:icons": "node tools/build-icons.mjs",
		"build": "wp-scripts build --webpack-src-dir=src --output-path=build",
		"start": "wp-scripts start --webpack-src-dir=src --output-path=build",
		"lint:js": "wp-scripts lint-js src",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"lint:php": "composer run lint",
		"test:js": "wp-scripts test-unit-js",
		"pot": "wp i18n make-pot . languages/iconjet.pot --slug=iconjet --domain=iconjet --exclude=node_modules,vendor,vendor-prefixed,dist,tests,tools,src",
		"zip": "node tools/make-zip.mjs"
	},
	"devDependencies": {
		"@fortawesome/fontawesome-free": "7.3.1",
		"@material-symbols/svg-400": "0.47.5",
		"@phosphor-icons/core": "2.1.1",
		"@tabler/icons": "3.48.0",
		"@wordpress/a11y": "4.56.0",
		"@wordpress/api-fetch": "7.56.0",
		"@wordpress/block-editor": "18.0.0",
		"@wordpress/blocks": "16.1.0",
		"@wordpress/components": "41.0.0",
		"@wordpress/compose": "8.9.0",
		"@wordpress/dom-ready": "4.56.0",
		"@wordpress/element": "8.8.0",
		"@wordpress/hooks": "4.56.0",
		"@wordpress/i18n": "6.29.0",
		"@wordpress/scripts": "35.0.0",
		"@wordpress/url": "4.56.0",
		"bootstrap-icons": "1.13.1",
		"lucide-static": "1.49.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"simple-icons": "16.33.0",
		"svgo": "4.1.0"
	}
}
